<mvc:View
  controllerName="com.btpconsulting.auditlog.controller.Main"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core">

  <Page id="mainPage" title="{i18n>appTitle}" showNavButton="false">

    <l:Grid containerQuery="true" defaultSpan="L2 M4 S6" hSpacing="1" vSpacing="1" class="sapUiSmallMargin">
      <GenericTile header="{i18n>kpiEvents}"     frameType="OneByOne"><TileContent><NumericContent value="{audit>/summary/totalEvents30d}" /></TileContent></GenericTile>
      <GenericTile header="{i18n>kpiCritical}"   frameType="OneByOne"><TileContent><NumericContent value="{audit>/summary/criticalEvents30d}" valueColor="Error" /></TileContent></GenericTile>
      <GenericTile header="{i18n>kpiAfterHours}" frameType="OneByOne"><TileContent><NumericContent value="{audit>/summary/afterHoursActions}" valueColor="Critical" /></TileContent></GenericTile>
      <GenericTile header="{i18n>kpiFailed}"     frameType="OneByOne"><TileContent><NumericContent value="{audit>/summary/failedActions}" valueColor="Critical" /></TileContent></GenericTile>
      <GenericTile header="{i18n>kpiSubaccounts}" frameType="OneByOne"><TileContent><NumericContent value="{audit>/summary/activeSubaccounts}" /></TileContent></GenericTile>
      <GenericTile header="{i18n>kpiActors}"     frameType="OneByOne"><TileContent><NumericContent value="{audit>/summary/uniqueActors}" /></TileContent></GenericTile>
    </l:Grid>

    <Toolbar>
      <Label text="{i18n>labelDays}" />
      <Select selectedKey="{audit>/days}" change="onWindowChange">
        <items>
          <core:Item key="7"  text="Last 7 days"  />
          <core:Item key="30" text="Last 30 days" />
          <core:Item key="60" text="Last 60 days" />
          <core:Item key="90" text="Last 90 days" />
        </items>
      </Select>
      <ToolbarSpacer />
      <ObjectStatus
        text="{= ${audit>/summary/dataSource} === 'live' ? 'Live data' : ${audit>/summary/dataSource} === 'mixed' ? 'Mixed (partial creds)' : 'Mock data' }"
        state="{= ${audit>/summary/dataSource} === 'live' ? 'Success' : ${audit>/summary/dataSource} === 'mixed' ? 'Warning' : 'Error' }"
        icon="{= ${audit>/summary/dataSource} === 'live' ? 'sap-icon://connected' : 'sap-icon://disconnected' }"
        tooltip="Live when both SUBACCOUNT_KEYS (auditLog entries) and CTMS_* env vars are set; mixed if only one." />
      <Label text="Synced:" />
      <Text text="{path: 'audit>/summary/lastSyncAt', formatter: '.formatSyncTime'}" />
      <Button text="{i18n>btnRefresh}" icon="sap-icon://refresh"          press="onRefresh" />
      <Button text="{i18n>btnExport}"  icon="sap-icon://excel-attachment" press="onExport" />
    </Toolbar>

    <IconTabBar id="tabs" expandable="false" stretchContentHeight="true">
      <items>
        <IconTabFilter text="{i18n>tabAnomalies}" key="anomalies" count="{audit>/summary/criticalEvents30d}">
          <Table items="{audit>/anomalies}" growing="true" growingThreshold="100">
            <columns>
              <Column><Text text="{i18n>colSeverity}" /></Column>
              <Column><Text text="{i18n>colTime}" /></Column>
              <Column><Text text="{i18n>colSubaccount}" /></Column>
              <Column><Text text="{i18n>colActor}" /></Column>
              <Column><Text text="{i18n>colAction}" /></Column>
              <Column><Text text="{i18n>colResource}" /></Column>
              <Column><Text text="{i18n>colAnomaly}" /></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <ObjectStatus text="{audit>anomalySeverity}"
                                state="{= ${audit>anomalySeverity} === 'error' ? 'Error' : ${audit>anomalySeverity} === 'warn' ? 'Warning' : 'Information' }" />
                  <Text text="{audit>timestamp}" />
                  <Text text="{audit>subaccountName}" />
                  <Text text="{audit>actor}" />
                  <Text text="{audit>action}" />
                  <Text text="{audit>resourceType}: {audit>resourceId}" />
                  <Text text="{audit>anomalyId}" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>

        <IconTabFilter text="{i18n>tabEvents}" key="events" count="{audit>/summary/totalEvents30d}">
          <Table items="{audit>/events}" growing="true" growingThreshold="200">
            <columns>
              <Column><Text text="{i18n>colTime}" /></Column>
              <Column><Text text="{i18n>colSubaccount}" /></Column>
              <Column><Text text="{i18n>colActor}" /></Column>
              <Column><Text text="{i18n>colAction}" /></Column>
              <Column><Text text="{i18n>colResource}" /></Column>
              <Column><Text text="{i18n>colOutcome}" /></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{audit>timestamp}" />
                  <Text text="{audit>subaccountName}" />
                  <Text text="{audit>actor}" />
                  <Text text="{audit>action}" />
                  <Text text="{audit>resourceType}: {audit>resourceId}" />
                  <ObjectStatus text="{audit>outcome}"
                                state="{= ${audit>outcome} === 'success' ? 'Success' : 'Error' }" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>

        <IconTabFilter text="{i18n>tabTimeline}" key="timeline">
          <Table items="{audit>/timeline}" growing="true" growingThreshold="200">
            <columns>
              <Column><Text text="{i18n>colTime}" /></Column>
              <Column><Text text="{i18n>colSource}" /></Column>
              <Column><Text text="{i18n>colSubaccount}" /></Column>
              <Column><Text text="{i18n>colActor}" /></Column>
              <Column><Text text="{i18n>colSummary}" /></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{audit>timestamp}" />
                  <ObjectStatus text="{audit>source}"
                                state="{= ${audit>source} === 'audit' ? 'Information' : 'Success' }" />
                  <Text text="{audit>subaccountId}" />
                  <Text text="{audit>actor}" />
                  <Text text="{audit>summary}" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>
      </items>
    </IconTabBar>
  </Page>
</mvc:View>
