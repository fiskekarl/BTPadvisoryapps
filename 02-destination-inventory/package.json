{
  "name": "btp-destination-inventory",
  "version": "1.0.0",
  "description": "SAP BTP Destination & Connectivity Inventory — Fiori app on CAP Node.js",
  "engines": { "node": ">=20" },
  "dependencies": {
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "@cap-js/sqlite": "^2",
    "axios": "^1",
    "express": "^4",
    "passport": "^0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "@sap/eslint-plugin-cds": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production"
  },
  "cds": {
    "requires": {
      "auth": { "kind": "xsuaa" },
      "db": { "kind": "sqlite", "credentials": { "url": "destinv.db" } },
      "[development]": {
        "auth": "dummy",
        "db": { "kind": "sqlite", "credentials": { "url": ":memory:" } }
      }
    }
  }
}
